@{
    ViewData["Title"] = "About";
}
<div class="card">
    <h1>Thông tin sinh viên</h1>
    <p><b>Họ và tên:</b> @ViewBag.StudentName</p>
    <p><b>Mã sinh viên:</b> @ViewBag.StudentId</p>
    <p><b>Lớp:</b> @ViewBag.ClassName</p>
    <p><b>Ngành:</b> @ViewBag.Major</p>
    <p>URL: <code>/Home/About</code></p>
</div>
